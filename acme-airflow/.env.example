# ============================================================================
# acme-airflow — environment variables
# Copy to .env and fill in. The .env file is NOT committed to git.
# ============================================================================

# ---------- Airflow ----------
# On the server: run `id -u` and use your uid (e.g. 1001) to avoid permission
# issues on the log volumes. Local/Windows can leave it at 50000.
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Execution API JWT secret (Airflow 3.x). Same across all components,
# otherwise the task fails with "Invalid auth token: Signature verification failed".
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=

# ---------- Repo paths ----------
# On the SERVER: leave commented out (uses the defaults /opt/acme/*).
# LOCAL: point to the sibling clones.
# ACME_DBT_PATH=../acme-dw-dbt                                 # the only one used today (transformation)
# ACME_SHAREPOINT_PATH=../acme-sharepoint-connector   # once the SharePoint extraction is built
# ACME_SAP_PATH=../acme-sap-ingestion                 # LEGACY: SAP ingestion became SQL Agent jobs

# ============================================================================
# Business credentials do NOT live here.
# They are Airflow Connections/Variables, encrypted with AIRFLOW_FERNET_KEY
# in the metadata database. See README → "Credentials (Airflow Connections)".
# The DAGs read the Connection and inject these env vars into the task at runtime:
#   dbt (in production):    DBT_PROD_HOST / _PORT / _DATABASE / _SCHEMA / _USER / _PASSWORD
#   SharePoint (to do):     SQLSERVER_* (destination) + GRAPH_TENANT_ID / _CLIENT_ID / _CLIENT_SECRET
# SAP ingestion left Airflow (SQL Server Agent jobs) — no HANA credentials here.
# ============================================================================
